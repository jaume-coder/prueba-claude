# Clave secreta para firmar JWT (cámbiala por una cadena larga y aleatoria)
SECRET_KEY=cambia-esto-por-una-clave-secreta-muy-larga

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-tu-password

# Google OAuth (obtenidos desde Google Cloud Console)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# URL base de la app (sin barra al final)
APP_BASE_URL=http://localhost:8000

# Entorno (development / production)
ENVIRONMENT=development
